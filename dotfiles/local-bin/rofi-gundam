#!/usr/bin/env bash
# rofi-gundam — switch the terminal variant without a terminal (Super+Shift+t)
#
# Front-end for gundam-theme: lists armor / panel / cockpit with the active
# variant marked and preselected, applies the choice, then pops a dunst
# notification with the two reloads that aren't free (ghostty, btop). The bar,
# borders, notifications, rofi itself and the wallpaper all follow on their
# own — gundam-theme reloads them.
set -euo pipefail

GT="$(command -v gundam-theme || echo "$HOME/.local/bin/gundam-theme")"

rows=(
  "armor    light — the dashboard's own colours"
  "panel    light — greyer ground, less glare"
  "cockpit  dark — for night work"
  "tokyonight  dark — the old Tokyo Night"
  "thinkpad  dark — P14s black, TrackPoint red"
)

# The notification lands after the switch, so it is drawn in the new colours —
# which doubles as the first thing you see confirming dunst followed.

active="$("$GT" status 2>/dev/null | awk 'NR==1 {print $2}')"

idx=-1
for i in "${!rows[@]}"; do
  [ "${rows[$i]%% *}" = "$active" ] && idx=$i
done

args=(-dmenu -i -p "gundam" -no-custom -mesg "active: ${active:-unknown}")
[ "$idx" -ge 0 ] && args+=(-selected-row "$idx" -a "$idx")

choice="$(printf '%s\n' "${rows[@]}" | rofi "${args[@]}")" || exit 0
[ -n "$choice" ] || exit 0
v="${choice%% *}"
[ "$v" = "$active" ] && exit 0

if out="$("$GT" "$v" 2>&1)"; then
  notify-send "Gundam: $v" \
    "ghostty: ctrl+shift+,  ·  btop: restart\nbar · borders · rofi · wallpaper · kitty · starship · claude: live"
else
  notify-send -u critical "gundam-theme $v failed" "$out"
  exit 1
fi
