# ~/.config/ghostty/config
# Gundam RX-78-2 (accents on dark) — tuned to match the framed Starship prompt.
# Reload after editing:  Linux  ctrl+shift+,   macOS  cmd+shift+,

# ── Font ─────────────────────────────────────────────────────────────────────
# Ghostty already bundles a Symbols Nerd Font fallback, so icons work even
# without this. Setting one explicit Nerd Font keeps glyph metrics consistent
# so the powerline bubble caps align perfectly with the text.
font-family = "JetBrainsMono Nerd Font"
# Optional extra fallback (uncomment if some glyphs go missing):
# font-family = "Symbols Nerd Font"
font-size = 13
font-thicken = true

# Ligatures on (set to -calt / -liga to disable)
font-feature = calt
font-feature = liga

# ── Colors: Gundam RX-78-2 "Federation Armor" ────────────────────────────────
# Colours live in themes/, not here, so the variant can be swapped without
# touching this file. gundam-active.conf is a symlink; point it somewhere else
# with `gundam-theme armor|panel|cockpit`, then reload ghostty.
#
#   armor    #e6e7e2  the dashboard's own ground — brightest
#   panel    #d2d4ce  recessed grey — same palette, less glare
#   cockpit  #12141a  the previous dark theme, for night work
#
# background-opacity lives in the theme files too: the light variants want a
# higher value than the dark one did.
config-file = /home/sbs/.config/ghostty/themes/gundam-active.conf

# ── Window & background ──────────────────────────────────────────────────────
# Blur is honored on macOS and KDE; ignored elsewhere (harmless).
background-blur-radius = 20

# Breathing room so the ╭─ … ╰─❯ frame reads as intentional, not cramped.
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true

window-decoration = true
window-theme = auto

# ── Cursor ───────────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = false

# ── Behavior / quality of life ───────────────────────────────────────────────
mouse-hide-while-typing = true
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
scrollback-limit = 100000
confirm-close-surface = false
shell-integration = detect
shell-integration-features = cursor,sudo,title

# macOS only: use left Option as Alt for shell keybindings (harmless on Linux)
macos-option-as-alt = left

# ── A couple of handy keybinds ───────────────────────────────────────────────
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+minus=new_split:down

