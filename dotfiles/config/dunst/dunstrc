# ~/.config/dunst/dunstrc — Tokyo Night (dunst 1.12+ syntax)
# Palette matches ghostty/kitty/starship/polybar/rofi/i3.

[global]
    monitor = 0
    follow = keyboard

    origin = top-right
    offset = (10, 10)
    width = 350
    height = (0, 300)
    gap_size = 8

    font = JetBrainsMono Nerd Font 11
    format = "<b>%s</b>\n%b"
    alignment = left
    markup = full
    show_indicators = yes

    frame_width = 2
    corner_radius = 8
    separator_height = 2
    separator_color = frame
    padding = 12
    horizontal_padding = 12

    icon_position = left
    max_icon_size = 48
    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark, Papirus, Adwaita

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 4

    idle_threshold = 120
    history_length = 50
    sort = yes
    stack_duplicates = true

    # picom is told not to add shadow/rounding (class_g = 'Dunst' excludes);
    # dunst draws its own rounded corners via corner_radius above.
    mouse_left_click = do_action, close_current
    mouse_middle_click = context
    mouse_right_click = close_all

[urgency_low]
    background = "#1a1b26"
    foreground = "#a9b1d6"
    frame_color = "#414868"
    highlight = "#7aa2f7"
    timeout = 5

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7"
    highlight = "#7aa2f7"
    timeout = 8

[urgency_critical]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#f7768e"
    highlight = "#f7768e"
    timeout = 0
