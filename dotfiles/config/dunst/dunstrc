# ~/.config/dunst/dunstrc — Gundam RX-78-2 "Federation Armor" (dunst 1.12+ syntax)
#
# Shape only. The colours (and the icon set, which follows light/dark) live in
# themes/gundam-<variant>.conf and reach dunst as the drop-in
# dunstrc.d/50-gundam-active.conf, which gundam-theme repoints. Drop-ins
# outrank this file, so setting a colour here would do nothing.
#
# A notification is one of the dashboard's .svc rows lifted off the page: an
# armour-white card, a grey seam around it, and a 4px colour-coded rule down
# the left edge saying how much you should care. Corners are square, because
# nothing on the page is rounded.
#
# Palette: ~/.config/gundam/palette.md

[global]
    monitor = 0
    follow = keyboard

    origin = top-right
    offset = (10, 10)
    width = 350
    height = (0, 300)
    gap_size = 8

    font = JetBrainsMono Nerd Font 11
    format = "<b>%s</b>\n%b"
    alignment = left
    markup = full
    show_indicators = yes

    # The status rule: frame_width draws all four sides, so the left-edge
    # emphasis comes from a thicker frame plus the per-urgency colour below.
    frame_width = 2
    # Square. The dashboard has no border-radius anywhere.
    corner_radius = 0
    separator_height = 2
    separator_color = frame
    padding = 12
    horizontal_padding = 12

    icon_position = left
    max_icon_size = 48
    enable_recursive_icon_lookup = true
    # icon_theme: set per variant in themes/gundam-<variant>.conf

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    # Square, like the page's .progress track.
    progress_bar_corner_radius = 0

    idle_threshold = 120
    history_length = 50
    sort = yes
    stack_duplicates = true

    # picom is told not to add shadow/rounding (class_g = 'Dunst' excludes);
    # dunst draws its own corners via corner_radius above.
    mouse_left_click = do_action, close_current
    mouse_middle_click = context
    mouse_right_click = close_all

# How long each level stays up. Colours: themes/gundam-<variant>.conf.
[urgency_low]
    timeout = 5

[urgency_normal]
    timeout = 8

[urgency_critical]
    timeout = 0
