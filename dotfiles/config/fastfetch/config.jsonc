// ~/.config/fastfetch/config.jsonc — Gundam RX-78-2
// Replaces neofetch (unmaintained since 2021, archived 2024). Same info list
// the old neofetch config printed, plus the RX-78-2 head as the logo.
//
// Everything is ANSI colours, not hex — so the output follows whichever
// gundam-theme variant (armor/panel/cockpit) the terminal is wearing.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/rx78-head.txt",
    "color": {
      "1": "39", // armour — default foreground (ink on light variants)
      "2": "33", // V-fin / side ducts — yellow
      "3": "31", // forehead jewel + chin — red
      "4": "32", // camera eyes — green
      "5": "30"  // visor shadow — the palette's grey
    },
    "padding": { "top": 1, "left": 1, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "34",  // Federation blue
      "title": "31"  // chest red
    },
    "key": { "width": 12 }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "▰" },
    { "type": "os",           "key": "OS" },
    { "type": "host",         "key": "HOST" },
    { "type": "kernel",       "key": "KERNEL" },
    { "type": "uptime",       "key": "UPTIME" },
    { "type": "packages",     "key": "PACKAGES" },
    { "type": "shell",        "key": "SHELL" },
    { "type": "display",      "key": "RESOLUTION" },
    { "type": "de",           "key": "DE" },
    { "type": "wm",           "key": "WM" },
    { "type": "wmtheme",      "key": "WM THEME" },
    { "type": "theme",        "key": "THEME" },
    { "type": "icons",        "key": "ICONS" },
    { "type": "terminal",     "key": "TERMINAL" },
    { "type": "terminalfont", "key": "TERM FONT" },
    { "type": "cpu",          "key": "CPU" },
    { "type": "gpu",          "key": "GPU" },
    { "type": "memory",       "key": "MEMORY" },
    "break",
    "colors"
  ]
}
