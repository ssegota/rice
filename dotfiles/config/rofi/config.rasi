configuration {
    modi: "combi,drun,run,window";
    /* rofi-smart catches typed text that isn't an app: math -> result, URL -> firefox, else -> web search */
    combi-modes: "smart:/home/sbs/.local/bin/rofi-smart,drun";
    combi-hide-mode-prefix: true;
    show-icons: true;
    icon-theme: "Papirus";
    terminal: "ghostty";
    font: "JetBrainsMono Nerd Font 12";
    drun-display-format: "{name}";
    disable-history: false;
    sidebar-mode: false;
}

@theme "~/.config/rofi/themes/gundam.rasi"
