/* rofi colours — variant B: PANEL
 * Ground drops to --armor-lo and each surface steps down with it; the accents
 * are ARMOR's, which were picked to hold on both grounds.
 */
* {
    armor:          #d2d4ceff;
    armor-hi:       #e6e7e2ff;
    armor-lo:       #bec1baff;
    line:           #9ca098ff;
    ink:            #15181fff;
    ink-dim:        #545a66ff;
    blue:           #24408eff;
    blue-deep:      #1a2f6bff;
    red:            #c0272dff;
    yellow:         #f0b929ff;
    eye:            #3f9e56ff;

    slab:           #24408eff;
    on-slab:        #ffffffff;
    on-slab-dim:    #ffffffb0;
    on-slab-active: #f0b929ff;
    on-red:         #ffffffff;
}

/* Match highlighting: rofi will not accept a token here, only a literal. */
element-text {
    highlight: bold #c0272dff;
}
