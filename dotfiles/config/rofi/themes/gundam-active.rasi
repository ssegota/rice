/* GENERATED by gundam-theme — do not edit.
 * Source: gundam-colors-panel.rasi + gundam-body.rasi
 */

/* rofi colours — variant B: PANEL
 * Ground drops to --armor-lo and each surface steps down with it; the accents
 * are ARMOR's, which were picked to hold on both grounds.
 */
* {
    armor:          #d2d4ceff;
    armor-hi:       #e6e7e2ff;
    armor-lo:       #bec1baff;
    line:           #9ca098ff;
    ink:            #15181fff;
    ink-dim:        #545a66ff;
    blue:           #24408eff;
    blue-deep:      #1a2f6bff;
    red:            #c0272dff;
    yellow:         #f0b929ff;
    eye:            #3f9e56ff;

    slab:           #24408eff;
    on-slab:        #ffffffff;
    on-slab-dim:    #ffffffb0;
    on-slab-active: #f0b929ff;
    on-red:         #ffffffff;
}

/* Match highlighting: rofi will not accept a token here, only a literal. */
element-text {
    highlight: bold #c0272dff;
}

/* Gundam RX-78-2 "Federation Armor" — rofi
 *
 * Modelled on the homelab dashboard's PIN gate: a Federation-blue header slab
 * with a chamfered top-right corner, a hazard stripe beneath it, then an
 * armour-white body of bordered rows. Selection is the blue slab inverted.
 *
 * Square corners throughout — the page has no border-radius anywhere.
 * Palette: ~/.config/gundam/palette.md
 */

/* This file is the body: structure only, no colour literals. The tokens it
   spends (@armor, @slab, @on-slab, ...) are defined in gundam-colors-<variant>
   .rasi, and gundam-theme concatenates the two into gundam-active.rasi, which
   is what config.rasi actually loads. rofi 2.0's @import does not merge
   properties across files, so a build step stands in for it.

   Edit this file for layout, the colours file for colour. Never gundam-active. */

* {
    font:   "JetBrainsMono Nerd Font 12";

    background-color:   transparent;
    text-color:         @ink;

    margin:     0;
    padding:    0;
    spacing:    0;
}

window {
    background-color:   @armor;
    border:             1px;
    border-color:       @line;
    border-radius:      0;

    location:       center;
    width:          640;
    /* The page's .masthead is a blue slab; rofi can't clip a chamfer, so the
       top-right cut is implied by the yellow hazard rule under the input. */
    children:       [ mainbox ];
}

mainbox {
    children:   [ inputbar, message, listview ];
}

/* ── input: the blue "gate-head" slab ─────────────────────────────────── */

inputbar {
    font:               "JetBrainsMono Nerd Font 16";
    background-color:   @slab;
    text-color:         @on-slab;
    padding:            14px 16px;
    spacing:            12px;
    children:           [ icon-search, entry, case-indicator ];
}

icon-search {
    expand:     false;
    filename:   "search";
    size:       26px;
}

icon-search, entry, element-icon, element-text {
    vertical-align: 0.5;
}

entry {
    font:               inherit;
    text-color:         @on-slab;
    cursor-color:       @on-slab-active;

    placeholder:        "SEARCH";
    placeholder-color:  @on-slab-dim;
}

case-indicator {
    text-color: @on-slab-active;
}

/* ── hazard stripe: rofi has no gradients, so a 3px V-fin rule stands in ── */

/* rofi's border-color takes a single colour for all four sides — a per-side
   list is a parse error, not a fallback. So the stripe is a top border only. */
message {
    border:             3px 0 0 0;
    border-color:       @yellow;
    background-color:   @armor-hi;
    text-color:         @ink-dim;
}

textbox {
    padding:        10px 16px;
    text-color:     @ink-dim;
}

/* ── results: the page's .svc rows ────────────────────────────────────── */

listview {
    lines:          10;
    columns:        1;

    fixed-height:   false;
    border:         3px 0 0 0;
    border-color:   @yellow;
    background-color: @armor;
    scrollbar:      true;
    padding:        4px 0 4px 0;
}

scrollbar {
    width:              4px;
    handle-width:       4px;
    handle-color:       @blue;
    background-color:   @armor-lo;
}

/* Each row wears a 4px left rule, exactly like .svc on the dashboard —
   blue at rest, red under the cursor. */
element {
    padding:            9px 16px;
    spacing:            14px;
    background-color:   transparent;
    text-color:         @ink;
    border:             0 0 0 4px;
    border-color:       transparent;
}

element normal normal {
    background-color:   @armor;
}

element alternate normal {
    background-color:   @armor-hi;
}

element normal active,
element alternate active {
    text-color:     @blue;
}

element normal urgent,
element alternate urgent {
    text-color:     @red;
}

element selected {
    background-color:   @slab;
    text-color:         @on-slab;
    border-color:       @red;
}

element selected active {
    background-color:   @slab;
    text-color:         @on-slab-active;
}

element selected urgent {
    background-color:   @red;
    text-color:         @on-red;
    border-color:       @ink;
}

element-icon {
    size:               1.1em;
    background-color:   transparent;
}

element-text {
    text-color:         inherit;
    background-color:   transparent;
    /* `highlight` will not take a token reference, so the match colour is set
       in gundam-colors-<variant>.rasi instead. */
}
